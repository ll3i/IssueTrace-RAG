# API Keys - 하나 이상 설정 필요
OPENAI_API_KEY=sk-...
UPSTAGE_API_KEY=up_...

# 임베딩 제공자 선택: "openai" 또는 "upstage"
EMBEDDING_PROVIDER=openai

# 생성 모델 선택
# openai: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# upstage: solar-pro, solar-mini
GENERATION_MODEL=gpt-4o-mini

# 재정렬 사용 여부: "upstage" 또는 "none"
RERANKER=none

# 데이터 경로 (절대경로)
DATA_DIR=c:/Users/SSAFY/Desktop/공정거래_데이터/AI활용데이터
INDEX_DIR=c:/Users/SSAFY/Desktop/공정거래_데이터/rag_system/index
